{
  "hooks": {
    "SessionStart": [{"matcher": "startup|resume|fork", "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"", "timeout": 5}]}],
    "PreToolUse": [{"matcher": ".*", "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/guard.py\"", "timeout": 5}]}]
  }
}
